{
  "name": "kazimo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "onnxruntime-node"
  ],
  "scripts": {
    "dev": "bun run --watch packages/kazimod/src/index.ts",
    "start": "NODE_ENV=production bun run packages/kazimod/src/index.ts",
    "test": "bun test packages/shared/src packages/kiosk/src packages/kazimod/src",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/kiosk && tsc --noEmit -p packages/kazimod",
    "check": "biome check packages",
    "format": "biome check --write packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
